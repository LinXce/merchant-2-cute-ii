<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <!-- OS Detection -->
    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <!-- Windows -->
    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <AutoSteamPath>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == '' and Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">E:/SteamLibrary/steamapps</SteamLibraryPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
        
        <!-- 添加 Mod 输出目录 -->
        <ModOutputPath>$(ModsPath)Merchant2CuteII\</ModOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
            <Publicize>True</Publicize>
        </Reference>
    </ItemGroup>

    <!--
      ==== 可选的前置库设置接入（默认关闭，保持零依赖） ====
      BaseLib:   dotnet build -c ExportRelease -p:MerchantBaseLib=true
      RitsuLib:  dotnet build -c ExportRelease -p:MerchantRitsuLib=true
      两个都开:   -p:MerchantBaseLib=true -p:MerchantRitsuLib=true

      打开之后记得在 Merchant2CuteII.json 的 dependencies 里声明对应库，
      否则玩家侧可能缺少前置而加载失败（见 docs/16）。
    -->
    <PropertyGroup>
        <MerchantBaseLib Condition="'$(MerchantBaseLib)' == ''">false</MerchantBaseLib>
        <MerchantRitsuLib Condition="'$(MerchantRitsuLib)' == ''">false</MerchantRitsuLib>
        <MerchantLibsRoot Condition="'$(MerchantLibsRoot)' == ''">$(MSBuildProjectDirectory)\..\..\other</MerchantLibsRoot>
        <DefineConstants Condition="'$(MerchantBaseLib)' == 'true'">$(DefineConstants);MERCHANT_BASELIB</DefineConstants>
        <DefineConstants Condition="'$(MerchantRitsuLib)' == 'true'">$(DefineConstants);MERCHANT_RITSILIB</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(MerchantBaseLib)' == 'true'">
        <Reference Include="BaseLib">
            <HintPath>$(MerchantLibsRoot)\BaseLib\BaseLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(MerchantRitsuLib)' == 'true'">
        <Reference Include="STS2-RitsuLib">
            <HintPath>$(MerchantLibsRoot)\STS2-RitsuLib\compat\0.111.0\STS2-RitsuLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="STS2-RitsuLib.Runtime">
            <HintPath>$(MerchantLibsRoot)\STS2-RitsuLib\compat\0.111.0\STS2-RitsuLib.Runtime.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="STS2-RitsuLib.Settings">
            <HintPath>$(MerchantLibsRoot)\STS2-RitsuLib\shared\STS2-RitsuLib.Settings.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="STS2-RitsuLib.Shared">
            <HintPath>$(MerchantLibsRoot)\STS2-RitsuLib\shared\STS2-RitsuLib.Shared.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- 自动复制 DLL -->
    <Target Name="CopyToModsFolder" AfterTargets="Build">
        <PropertyGroup>
            <ModTargetDir>$(ModOutputPath)</ModTargetDir>
        </PropertyGroup>
        <MakeDir Directories="$(ModTargetDir)" Condition="!Exists('$(ModTargetDir)')" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ModTargetDir)" />
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="./" />
        <Message Text="Copied $(AssemblyName).dll to $(ModTargetDir)" Importance="high" />
    </Target>
</Project>